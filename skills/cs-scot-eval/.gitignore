# v1(suite_real):提交考题(data/truth/rca_input/binding_question);忽略模型答案与题面/报告
suite_real/*/rca.json
suite_real/*/binding.json
suite_real/*/prompt.txt
suite_real/*/binding_prompt.txt
suite_real/_HOWTO_prompts.md
suite_real/*_report.txt
suite_real/batch_rca.py

# v2(suite_v2):只提交【手工源题库】(fault_tree.csv / gold_tree.json / scenarios/*/data / truth.json)+ 生成器/编排/打分脚本。
# 忽略流水线产物(v2_run.py 一条命令确定性重生)与模型答案/题面/报告:
suite_v2/scot产物/
suite_v2/binding_question.json
suite_v2/binding.json
suite_v2/binding_prompt.txt
suite_v2/_HOWTO_prompts.md
suite_v2/*_report.txt
suite_v2/scenarios/*/rca_input.json
suite_v2/scenarios/*/rca_input_hard.json
suite_v2/scenarios/*/rca.json
suite_v2/scenarios/*/prompt.txt

# v3(suite_v3):跨规模综合(v2 ⊕ v1 融合)。只提交 README;manifest 与报告确定性重生
suite_v3/manifest.json
suite_v3/*_report.txt

# v3 hard 模式:删标签后的输入,确定性重生(v3_run.py --hard)
suite_real/*/rca_input_hard.json
